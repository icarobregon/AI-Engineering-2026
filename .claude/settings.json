{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-session-merge.sh",
            "timeout": 5,
            "statusMessage": "Verificando que no es un merge prematuro de sesión…"
          }
        ]
      }
    ]
  }
}
