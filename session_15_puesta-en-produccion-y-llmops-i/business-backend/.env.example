# Business backend — public entry point of the estimation system.
# Copy to .env and fill in the real values. NEVER commit .env.

# --- Frontier with the AI service -------------------------------------------
# Inside Compose the AI service is reached by its SERVICE NAME, never by
# localhost: localhost inside a container is that same container.
AI_SERVICE_URL=http://ai-service:8000

# The shared secret for service-to-service calls. The AI service reads it as
# ESTIMATE_API_KEY and expects it on the X-API-Key header. Same value on both
# sides, one per environment. No default: an empty value must fail loudly.
AI_SERVICE_TOKEN=

# Optional: only needed if the retrieval routes get their own key.
AI_SERVICE_RETRIEVAL_TOKEN=

# --- Own datastore -----------------------------------------------------------
# Same Postgres as the AI service, separate schema so nothing can collide.
# Inside Compose the host is the service name and the port is 5432.
DATABASE_URL=postgresql://USER:PASSWORD@estimator-postgres:5432/estimator?schema=business
