# Values shared by the whole stack. Copy to .env and fill in.
# Only this .example is versioned — never .env.

# The service-to-service secret. Same value on both sides of the frontier: the
# business backend sends it, the AI service checks it. One per environment.
AI_SERVICE_TOKEN=

# Optional: a separate key for the retrieval routes. Defaults to the one above.
AI_SERVICE_RETRIEVAL_TOKEN=

# Datastore credentials. Interpolated into both services' connection strings so
# there is no password written literally in docker-compose.yml.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
