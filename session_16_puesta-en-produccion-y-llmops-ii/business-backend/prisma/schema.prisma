// The business backend's own state.
//
// It lives in a separate Postgres SCHEMA on the same database as the AI service
// (the `?schema=business` on DATABASE_URL), so there is one datastore to operate
// and no chance of a table name colliding with the estimator's.
//
// Five of the AI service's own tables already hold the authoritative state of a
// run — the checkpointer keyed by estimation_id owns it. What is persisted here
// is what the AI service cannot answer: the history of what WE asked for, and
// enough of each answer to render a list without replaying every run.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Session 4 — one transactional estimate, request and answer.
model Estimation {
  id           String @id @default(uuid())
  description  String
  projectType  String @map("project_type")
  detailLevel  String @map("detail_level")
  outputFormat String @map("output_format")

  /// The validated EstimationResponse, stored whole: the AI service owns this
  /// shape, and re-deriving columns from it would just be a second source of
  /// truth that drifts.
  responsePayload Json    @map("response_payload")
  promptVersion   String  @map("prompt_version")
  cached          Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("estimations")
}

/// Sessions 13-14 — one supervised run and, when it stopped, its review.
model SupervisorRun {
  id String @id @default(uuid())

  /// The AI service's thread_id. Unique because sending it again is a retry of
  /// the same estimation, not a new one.
  estimationId String @unique @map("estimation_id")

  transcript String

  /// Where WE think the run is: running | paused | completed.
  /// The authoritative state is the checkpointer's; this is what lets the inbox
  /// render without calling the AI service once per row.
  runState String @default("running") @map("run_state")

  /// The AI service's own status: validated | needs_review |
  /// awaiting_human_review | routing_budget_exhausted.
  status String?

  estimate      Json?  @db.JsonB
  reviewPayload Json?  @map("review_payload") @db.JsonB

  /// Las referencias historicas que respaldan cada componente, copiadas del
  /// checkpoint. Duplicarlas aqui es deliberado: el checkpointer sigue siendo la
  /// fuente autoritativa, pero solo llegaban a esta fila dentro de
  /// `review_payload`, que existe UNICAMENTE si el run se paro ante una persona.
  /// Una estimacion que salio limpia no tiene payload, asi que su desglose
  /// dependia de que el servicio IA contestara, y la pagina ya degrada ese fetch
  /// a null cuando no lo hace. Sin esta columna, «de donde sale este numero» era
  /// una pregunta que la pantalla no podia responder con el servicio caido.
  budgetMatches Json? @map("budget_matches") @db.JsonB
  humanDecision Json?  @map("human_decision") @db.JsonB
  errors        Json   @default("[]") @db.JsonB
  confidence    Float?

  /// The commercial proposal, as the AI service returned it. Nullable because
  /// most runs never get one: it is drafted on request, after the estimate is
  /// settled. Stored whole rather than split into columns — the AI service owns
  /// its shape, and the one part this app adds (the PDF) reads all of it.
  proposal Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([runState, status])
  @@map("supervisor_runs")
}

/// Sesión 11 — una ampliación del corpus vectorial y cómo fue.
///
/// El trabajo asíncrono vive AQUÍ, no en el servicio IA: su ruta de ingesta es
/// síncrona y acepta un documento por llamada, así que el lote, su progreso y su
/// resultado son estado de negocio. Es el mismo reparto que hace la aplicación de
/// referencia, cuyo sondeo también consulta a su propio backend.
model IndexRun {
  id String @id @default(uuid())

  chunkType String @map("chunk_type")

  /// El JSON tal y como lo pegó la persona. La app de referencia NO lo guarda, y
  /// sin él no se puede reintentar una ampliación ni diagnosticar por qué falló.
  documentsJson String @map("documents_json")

  submittedCount Int @map("submitted_count")
  processedCount Int @default(0) @map("processed_count")
  /// Documentos que el servicio IA ya tenía (409). No son un fallo.
  skippedCount   Int @default(0) @map("skipped_count")
  chunksCreated  Int @default(0) @map("chunks_created")

  /// pending | running | completed | failed.
  status String @default("pending")

  /// Por qué falló. La app de referencia lo recibe del servicio y lo descarta,
  /// y por eso pinta en verde un trabajo fallido.
  errorMessage String? @map("error_message")

  /// La foto del corpus antes y después, congelada. No se vuelve a pedir al
  /// servicio al abrir la página: el "antes" ya no existiría.
  beforeStats Json? @map("before_stats") @db.JsonB
  afterStats  Json? @map("after_stats") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("index_runs")
}

/// Sesiones 09-12 — el asistente RAG de cinco pasos.
///
/// Una columna JSONB por paso, y el paso actual aparte. Cada etapa es
/// re-ejecutable, así que lo que guarda una etapa no puede depender de que la
/// siguiente exista: la fila es válida en cualquiera de los cinco estados.
model RagRun {
  id String @id @default(uuid())

  /// Inmutable: re-ejecutar la reformulación la vuelve a leer, no la cambia.
  transcript String

  /// reformulation | structure | review | hours | verification.
  currentStep String @default("reformulation") @map("current_step")

  /// Paso 1 — el brief tipado que sale de la transcripción.
  reformulation Json? @db.JsonB

  /// Paso 2 — el árbol que propone el modelo, sin tocar.
  structure Json? @db.JsonB

  /// Paso 3 — el árbol DESPUÉS de que una persona lo corrija. Se guarda aparte
  /// de `structure` para poder enseñar qué cambió el humano y qué propuso el
  /// modelo; fundirlos perdería esa comparación para siempre.
  reviewedModules Json? @map("reviewed_modules") @db.JsonB

  /// Paso 4 — las horas por tarea, con su fiabilidad y sus vecinos.
  taskHours Json? @map("task_hours") @db.JsonB

  /// Paso 5 — horas y tarifas confirmadas por una persona, con sus totales.
  /// Conserva la fiabilidad y los vecinos: la app de referencia los tira al
  /// confirmar, y con ellos se va la única señal de qué números eran flojos.
  verification Json? @db.JsonB

  confirmedAt DateTime? @map("confirmed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("rag_runs")
}

/// Sesión 12 — un perfil del agente escrito a mano.
///
/// Es configuración de NEGOCIO —cómo queremos que corra el agente—, así que vive
/// aquí y no en el servicio IA: el servicio recibe los valores en la llamada y no
/// los guarda. Esa separación es la que permite tener varios perfiles sin que el
/// servicio sepa que existen.
model AgentProfile {
  id String @id @default(uuid())

  name        String
  description String?

  /// Los tres que el endpoint del agente acepta por llamada. Nulo significa
  /// «lo que diga el .env del servicio», que es distinto de un valor por
  /// defecto copiado aquí: copiarlo lo congelaría.
  model           String?
  reasoningEffort String? @map("reasoning_effort")
  maxIterations   Int?    @map("max_iterations")

  /// El que se preselecciona al lanzar. A diferencia de la app de referencia,
  /// aquí esto hace algo: allí `is_default` sólo pintaba una etiqueta.
  isDefault Boolean @default(false) @map("is_default")

  runs AgentRun[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("agent_profiles")
}

/// Sesión 12 — una ejecución del agente, lanzada desde la consola.
///
/// El bucle encadena varias llamadas a un modelo de razonamiento y tarda
/// minutos, así que el trabajo corre en segundo plano y la pantalla sondea esta
/// fila. Mismo patrón que las ampliaciones del corpus, y por los mismos motivos.
model AgentRun {
  id String @id @default(uuid())

  profile   AgentProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  profileId String?       @map("profile_id")

  /// Los ajustes CON LOS QUE SE LANZÓ, copiados. El perfil puede cambiar después
  /// —o borrarse— y esta ejecución tiene que seguir explicándose a sí misma.
  model           String
  reasoningEffort String @map("reasoning_effort")
  maxIterations   Int    @map("max_iterations")

  transcript String

  /// pending | running | completed | failed.
  status       String  @default("pending")
  errorMessage String? @map("error_message")

  /// La estimación y la traza, tal y como las devuelve el servicio.
  estimate Json? @db.JsonB
  trace    Json? @db.JsonB

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("agent_runs")
}
